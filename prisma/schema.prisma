generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EmployeeRegistration {
  id           String @id @default(cuid())
  firstName    String
  lastName     String
  dateOfBirth  String
  gender       String
  profilePhoto String

  email                 String  @unique
  phone                 String  @unique
  address               String
  suburb                String
  state                 String
  postcode              String
  notifyBySms           Boolean
  notifyByEmail         Boolean
  emergencyContactName  String
  emergencyContactPhone String

  visaStatus       String
  visaOther        String
  visaExpiry       String
  hasWorkingRights Boolean
  tfn              String
  hasAbn           Boolean
  abn              String

  workType                  String
  preferredDays             String[]
  preferredTimeSlots        Json
  daySlots                  Json
  urgency                   String
  expectedPayRate           String
  willingToTravel           Boolean
  hasDriverLicense          Boolean
  maxTravelKm               String
  hasSickLeave              Boolean
  hasAnnualLeave            Boolean
  hasPublicHolidayRate      Boolean
  hasRegisteredVehicle      Boolean
  vehicleRegistrationNumber String

  hasPoliceCheck         Boolean
  policeCheckExpiry      String
  hasWorkingWithChildren Boolean
  wwcExpiry              String
  hasPublicLiability     Boolean
  insuranceExpiry        String
  hasCovidVaccination    Boolean
  otherDocs              String

  certifications  String[]
  machinesHandled String[]
  yearsExperience String
  specialisations String[]
  references      Json

  accountName       String
  bsb               String
  accountNumber     String
  superFundName     String
  superMemberNumber String
  paymentMethod     String

  status        RegistrationStatus @default(PENDING)
  agreedToTerms Boolean
  submittedAt   DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  jobs          Job[]
  invoices      Invoice[]
  payments      Payment[]
}

enum RegistrationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum JobStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Job {
  id            String                @id @default(cuid())
  title         String
  category      String
  description   String                @default("")
  address       String                @default("")
  suburb        String                @default("")
  state         String                @default("NSW")
  postcode      String                @default("")
  scheduledDate DateTime?
  startTime     String                @default("")
  endTime       String                @default("")
  payRate       String                @default("")
  notes         String                @default("")
  status        JobStatus             @default(OPEN)
  employeeId    String?
  employee      EmployeeRegistration? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  invoices      Invoice[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Invoice {
  id         String                @id @default(cuid())
  number     String                @unique
  amount     String
  status     InvoiceStatus         @default(DRAFT)
  dueDate    DateTime?
  notes      String                @default("")
  employeeId String
  employee   EmployeeRegistration  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?                  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  payments   Payment[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model Payment {
  id         String                @id @default(cuid())
  amount     String
  method     String                @default("bank-transfer")
  status     PaymentStatus         @default(COMPLETED)
  paidAt     DateTime              @default(now())
  reference  String                @default("")
  employeeId String
  employee   EmployeeRegistration  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  invoiceId  String?
  invoice    Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt  DateTime              @default(now())
}
